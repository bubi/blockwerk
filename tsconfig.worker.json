{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "#test-db": ["./worker/db/testing/get-test-db.workers.ts"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["worker", "shared", "worker-configuration.d.ts"],
  "exclude": [
    "worker/db/vitest.config.ts",
    "worker/db/testing/get-test-db.local.ts",
    "worker/db/testing/sqlite-d1.ts"
  ]
}
