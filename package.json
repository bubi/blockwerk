{
  "name": "blockwerk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && npm run db:seed && concurrently -k -n worker,vite -c auto \"npm run dev:worker\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev",
    "build": "tsc -b tsconfig.app.json tsconfig.worker.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.worker.json tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:workers": "vitest run -c worker/db/vitest.config.ts",
    "test:e2e": "playwright test",
    "e2e:server": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed && npm run build && node scripts/e2e-server.mjs",
    "types:worker": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply blockwerk --local",
    "db:migrate:remote": "wrangler d1 migrations apply blockwerk --remote",
    "db:seed": "wrangler d1 execute blockwerk --local --file=./seed.sql",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
