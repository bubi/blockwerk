{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["vite.config.ts", "worker/db/vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
